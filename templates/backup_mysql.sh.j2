#!/bin/bash
# Backup automatico de MariaDB - generado por Ansible
FECHA=$(date +%Y%m%d_%H%M%S)
BACKUP_DIR="{{ backup_dir }}"
DB_NAME="{{ DB_DBASE }}"
CNF_FILE="/root/.my_backup.cnf"

mysqldump --defaults-extra-file="$CNF_FILE" "$DB_NAME" > "$BACKUP_DIR/${DB_NAME}_${FECHA}.sql"

# Borra backups con mas de {{ backup_retention_days }} dias
find "$BACKUP_DIR" -name "*.sql" -mtime +{{ backup_retention_days }} -delete
